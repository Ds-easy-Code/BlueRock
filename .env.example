# Copy this file to .env (same folder as host_gui.py / compose.yaml) and
# fill in your paths. .env is loaded automatically when host_gui.py starts.
#
# Real environment variables (set in your shell/OS) always take priority
# over whatever is in .env.
#
# .env itself is gitignored -- only this .env.example template is tracked,
# so your local paths never get committed.

# Folder the "Choose File(s) & Launch" dialog opens into by default, so you
# don't have to navigate from the filesystem root every time.
BLUEROCK_SOURCE_DIR=/path/to/your/source/folder

# Folder the "Move current file to destination" field/dialog is preloaded
# with.
BLUEROCK_DEST_DIR=/path/to/your/destination/folder
